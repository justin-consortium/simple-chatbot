MONGODB_URI=mongodb://localhost:27017/chatbot
JWT_SECRET=change-this-to-a-long-random-secret

# OpenAI credentials.
# For standard OpenAI access, set OPENAI_API_KEY and leave OPENAI_BASE_URL blank.
# For institutional gateways (e.g. University of Michigan UMGPT), set both:
#   OPENAI_API_KEY=<your UMGPT API key>
#   OPENAI_BASE_URL=<your UMGPT Gateway Base URL>
OPENAI_API_KEY=
OPENAI_BASE_URL=

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
